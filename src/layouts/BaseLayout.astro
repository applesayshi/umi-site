---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { Font, getImage } from 'astro:assets';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import AnnouncementBar from '../components/layout/AnnouncementBar.astro';
import SegmentSprite from '../components/ui/SegmentSprite.astro';
import { getSettings } from '../lib/content';
import { hash } from '../lib/random';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  /** A ready-made share image in public/, e.g. "/og-produceumi.jpg". Used when `image` isn't set. */
  ogImagePath?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** Structured data objects rendered as JSON-LD. */
  jsonLd?: Record<string, unknown>[];
}

const settings = await getSettings();
const {
  title,
  description = settings.description,
  image,
  ogImagePath = '/og-default.jpg',
  imageAlt,
  type = 'website',
  noindex = false,
  jsonLd = [],
} = Astro.props;

const site = Astro.site ?? new URL('https://www.ubcmusicinitiative.com');
const pageTitle = title ? `${title} — ${settings.shortName}` : `${settings.siteName} (${settings.shortName}) — ${settings.tagline}`;
const canonical = new URL(Astro.url.pathname, site);
const ogImage = image
  ? new URL((await getImage({ src: image, width: 1200, format: 'jpg', quality: 80 })).src, site)
  : new URL(ogImagePath, site);

const announceKey = settings.announcement.enabled && settings.announcement.text ? String(hash(settings.announcement.text)) : '';

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: settings.siteName,
  alternateName: settings.shortName,
  url: site.href,
  email: settings.email,
  logo: new URL('/icon-512.png', site).href,
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${settings.office.building}, 6133 University Boulevard`,
    addressLocality: 'Vancouver',
    addressRegion: 'BC',
    postalCode: 'V6T 1Z1',
    addressCountry: 'CA',
  },
  sameAs: Object.values(settings.socials).filter(Boolean),
};
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <script is:inline define:vars={{ announceKey }}>
      document.documentElement.classList.add('js');
      try {
        if (announceKey && localStorage.getItem('umi-announcement-dismissed') === announceKey) {
          document.documentElement.dataset.announcement = 'dismissed';
        }
      } catch (e) {}
    </script>

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-sans" preload={[{ weight: 400, style: 'normal' }]} />
    <!-- Italic serif sets every hero subtitle; preloading it stops a late swap from re-wrapping lines and nudging the layout. -->
    <Font cssVariable="--font-serif" preload={[{ weight: 400, style: 'italic' }]} />
    <Font cssVariable="--font-mono" />

    <meta name="theme-color" content="#070b1f" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/calendar" title="UMI events calendar" href="/calendar.ics" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={settings.siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta property="og:locale" content="en_CA" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify([organization, ...jsonLd])} />
  </head>
  <body class="theme-night">
    <a class="skip-link" href="#main">Skip to content</a>
    <SegmentSprite />
    <AnnouncementBar announcement={settings.announcement} storageKey={announceKey} />
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <div class="grain" aria-hidden="true"></div>

    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>

<style>
  main {
    display: block;
    outline: none;
    /* Tilted prints, tape and scribbles bleed off the edges by design. Clipping here (not only on
       body, whose overflow propagates to the viewport) stops phones from panning sideways. */
    overflow-x: clip;
  }
</style>
