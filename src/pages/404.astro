---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import DateStamp from '../components/ui/DateStamp.astro';
---

<BaseLayout title="Page not found" noindex>
  <section class="lost theme-night" aria-labelledby="lost-title">
    <div class="container lost__inner">
      <div class="lost__can" aria-hidden="true">
        <span class="lost__label display">404</span>
        <span class="lost__expiry">Best before</span>
        <DateStamp date={new Date()} class="lost__stamp" />
      </div>
      <div class="lost__copy">
        <p class="eyebrow"><span class="eyebrow__index">Error 404</span><span>Track not found</span></p>
        <h1 class="lost__title display" id="lost-title">This page has expired</h1>
        <p class="subtitle lost__text">Everything has an expiry date. This link's was a while ago.</p>
        <div class="btn-row">
          <a class="btn" href="/">
            <span class="btn__label">Back to the start</span>
            <Icon name="arrow-right" />
          </a>
          <a class="btn btn--ghost" href="/events">
            <span class="btn__label">What's on</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lost {
    min-height: 90svh;
    display: grid;
    align-items: center;
    padding-block: calc(var(--header-h) + var(--space-2xl)) var(--section);
  }

  .lost__inner {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
  }

  .lost__can {
    position: relative;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 0.4rem;
    width: min(70vw, 18rem);
    aspect-ratio: 3 / 4;
    border-radius: 1.2rem / 2.2rem;
    background:
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0.06) 0 2px, transparent 2px 14px),
      linear-gradient(90deg, #6f7690, #d5d9e4 22%, #858ca3 45%, #c9cedb 70%, #5e647b);
    box-shadow: var(--shadow-lift);
    transform: rotate(-6deg);
  }

  .lost__can::before {
    content: '';
    position: absolute;
    inset: 22% 0;
    background: var(--peri);
    box-shadow: inset 0 0 0 3px var(--orange-ink);
  }

  .lost__label {
    position: relative;
    font-size: 3rem;
    font-weight: 900;
    line-height: 0.9;
    color: var(--orange-ink);
  }

  .lost__expiry {
    position: relative;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .lost__can :global(.lost__stamp) {
    position: relative;
    font-size: 1.1rem;
  }

  .lost__copy {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
  }

  .lost__title {
    font-size: var(--display-xl);
    font-weight: 900;
    line-height: 0.84;
  }

  .lost__text {
    max-width: 30ch;
    font-size: var(--step-3);
  }

  @media (min-width: 900px) {
    .lost__inner {
      grid-template-columns: auto 1fr;
    }
  }
</style>
