---
import type { ImageMetadata } from 'astro';
import Photo from '../ui/Photo.astro';
import Scribble from '../ui/Scribble.astro';
import GlitchStrip from '../ui/GlitchStrip.astro';
import DataRail from '../ui/DataRail.astro';
import EditPin from '../ui/EditPin.astro';
import { fitStyle } from '../../lib/fit';

interface Props {
  eyebrow: string;
  index?: string;
  title: string;
  intro?: string;
  photo?: { src: ImageMetadata; alt: string; date?: Date; focus?: string };
  /** Show the glowing colour fields. Pages with their own art behind the whole page turn them off. */
  glow?: boolean;
  /** The CMS entry holding this page's words, for the editors' pencil (see lib/cms.ts). */
  edit?: string;
}

const { eyebrow, index, title, intro, photo, glow = true, edit } = Astro.props;
---

<section class="page-hero theme-night" aria-labelledby="page-title">
  {/* Pages can swap the glowing colour fields for their own backdrop, e.g. <ArtBackdrop slot="backdrop" … /> */}
  {Astro.slots.has('backdrop') ? <slot name="backdrop" /> : glow && <div class="page-hero__fields" aria-hidden="true"><i></i><i></i></div>}
  <DataRail class="page-hero__rail" text={`UMI — ${eyebrow.toUpperCase()} — ${title.toUpperCase()} — AMS STUDENT NEST`} />
  {edit && <EditPin href={edit} label="Edit page" style="--pin-top: calc(var(--header-h) + 0.75rem)" />}

  <div class:list={['container', 'page-hero__inner', photo && 'page-hero__inner--photo']}>
    <div class="page-hero__copy">
      <p class="eyebrow" data-reveal="fade">
        {index && <span class="eyebrow__index">{index}</span>}
        <span>{eyebrow}</span>
      </p>
      <h1 class="page-hero__title display glow-title" id="page-title" data-text={title} style={fitStyle(title)}>
        <span class="page-hero__title-inner">{title}</span>
      </h1>
      {intro && <p class="page-hero__intro subtitle">{intro}</p>}
      <slot />
    </div>
    {
      photo && (
        <div class="page-hero__photo">
          <Photo
            src={photo.src}
            alt={photo.alt}
            date={photo.date}
            position={photo.focus}
            sizes="(min-width: 960px) 32vw, 80vw"
            widths={[400, 640, 900, 1200]}
            aspect="4 / 3"
            frame="print"
            tape="top"
            tilt={2.5}
            misregister
            priority
          />
          <Scribble variant="loop" class="page-hero__loop" color="var(--orange)" width={2.5} />
        </div>
      )
    }
  </div>
  <GlitchStrip seed={`page-${title}`} height={18} class="page-hero__strip" />
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-top: calc(var(--header-h) + var(--space-3xl));
    padding-bottom: var(--space-3xl);
  }

  .page-hero__fields {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .page-hero__fields i {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
  }

  .page-hero__fields i:nth-child(1) {
    top: -20%;
    right: -6%;
    width: 50vw;
    height: 40vw;
    background: radial-gradient(closest-side, rgb(44 82 224 / 0.55), transparent);
  }

  .page-hero__fields i:nth-child(2) {
    top: 30%;
    right: 22%;
    width: 24vw;
    height: 20vw;
    background: radial-gradient(closest-side, rgb(255 90 43 / 0.28), transparent);
  }

  :global(.page-hero__rail) {
    display: none !important;
  }

  .page-hero__inner {
    position: relative;
    display: grid;
    gap: var(--space-2xl);
    align-items: end;
  }

  .page-hero__copy {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
    container-type: inline-size;
  }

  /* The whole heading (text and glow) fades and rises in smoothly on load. */
  .page-hero__title {
    --glow: var(--peri);
    font-size: min(var(--display-xl), 100cqi / var(--fit, 0.01));
    font-weight: 900;
    line-height: 0.9;
    animation: rise-in var(--dur-slower) var(--ease-out) both 60ms;
  }

  .page-hero__title-inner {
    display: inline-block;
  }

  .page-hero__intro {
    max-width: 34ch;
    font-size: var(--step-3);
    animation: rise-in var(--dur-slower) var(--ease-out) both 220ms;
  }

  .page-hero__photo {
    position: relative;
    width: min(100%, 34rem);
    justify-self: end;
    animation: rise-in 1100ms var(--ease-out) both 160ms;
  }

  .page-hero__photo :global(.page-hero__loop) {
    position: absolute;
    left: -18%;
    bottom: -12%;
    z-index: 3;
    width: 70%;
    height: auto;
  }

  :global(.page-hero__strip) {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    opacity: 0.9;
  }

  @media (min-width: 960px) {
    .page-hero__inner--photo {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
    }

    :global(.page-hero__rail) {
      position: absolute !important;
      top: calc(var(--header-h) + 2rem);
      bottom: 3rem;
      left: 0.9rem;
      display: flex !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-hero__title,
    .page-hero__intro,
    .page-hero__photo {
      animation: none;
    }
  }
</style>
