---
/**
 * For people logged in to the CMS in this browser: a small "Editor" button in the corner that opens tools to
 * edit the page they're on, open the content manager, or hide the pencils to see the page as visitors do.
 * It stays folded away unless opened (and remembers), so it doesn't cover the page. Hidden from everyone else.
 */
import Icon from '../ui/Icon.astro';
import { CMS_HOME } from '../../lib/cms';

interface Props {
  /** The CMS entry behind this page (see lib/cms.ts). */
  edit?: string;
}

const { edit } = Astro.props;
---

<div class="editor-bar" role="region" aria-label="Editing tools">
  <button class="editor-bar__btn editor-bar__handle" type="button" aria-expanded="false" aria-controls="editor-tools" data-editor-toggle>
    <Icon name="pencil" size="0.95rem" />
    <span>Editor</span>
  </button>
  <div class="editor-bar__tools" id="editor-tools" data-editor-tools hidden>
    {
      edit && (
        <a class="editor-bar__btn" href={edit}>
          <span>Edit this page</span>
        </a>
      )
    }
    <a class="editor-bar__btn" href={CMS_HOME}>
      <Icon name="list" size="0.95rem" />
      <span>All content</span>
    </a>
    <button class="editor-bar__btn editor-bar__pins" type="button" data-edit-pins-toggle aria-pressed="true">
      <span class="editor-bar__on"><Icon name="eye" size="0.95rem" /></span>
      <span class="editor-bar__off"><Icon name="eye-slash" size="0.95rem" /></span>
      <span>Pencils</span>
    </button>
  </div>
</div>

<style>
  .editor-bar {
    display: none;
  }

  :global(.is-cms-editor) .editor-bar {
    position: fixed;
    left: max(0.75rem, env(safe-area-inset-left));
    bottom: max(0.75rem, env(safe-area-inset-bottom));
    z-index: var(--z-overlay);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
    max-width: calc(100vw - 1.5rem);
    padding: 0.25rem;
    border: 1px solid rgb(238 241 250 / 0.2);
    border-radius: 1.5rem;
    background: rgb(7 11 31 / 0.92);
    box-shadow: 0 12px 30px -10px rgb(0 0 0 / 0.7);
    color: var(--chalk);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .editor-bar__tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
  }

  .editor-bar__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.5rem;
    padding: 0 0.85rem;
    border-radius: 999px;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    text-decoration: none;
    transition: background-color var(--dur-fast), color var(--dur-fast);
  }

  .editor-bar__btn:hover {
    background: var(--chalk);
    color: var(--night-950);
  }

  .editor-bar__handle {
    background: var(--sun);
    color: var(--night-950);
  }

  .editor-bar__handle[aria-expanded='true'] {
    background: transparent;
    color: var(--sun);
  }

  .editor-bar__on,
  .editor-bar__pins[aria-pressed='false'] .editor-bar__off {
    display: inline-flex;
  }

  .editor-bar__off,
  .editor-bar__pins[aria-pressed='false'] .editor-bar__on {
    display: none;
  }
</style>

<script>
  const root = document.documentElement;
  const handle = document.querySelector<HTMLButtonElement>('[data-editor-toggle]');
  const tools = document.querySelector<HTMLElement>('[data-editor-tools]');
  const pins = document.querySelector<HTMLButtonElement>('[data-edit-pins-toggle]');

  const remember = (key: string, value: string) => {
    try {
      localStorage.setItem(key, value);
    } catch {}
  };

  const setOpen = (open: boolean) => {
    if (!handle || !tools) return;
    handle.setAttribute('aria-expanded', String(open));
    tools.hidden = !open;
  };
  try {
    setOpen(localStorage.getItem('umi-editor-bar') === 'open');
  } catch {}
  handle?.addEventListener('click', () => {
    const open = handle.getAttribute('aria-expanded') !== 'true';
    setOpen(open);
    remember('umi-editor-bar', open ? 'open' : 'closed');
  });

  const syncPins = () => pins?.setAttribute('aria-pressed', String(!root.classList.contains('edit-pins-off')));
  syncPins();
  pins?.addEventListener('click', () => {
    const hidden = root.classList.toggle('edit-pins-off');
    remember('umi-edit-pins', hidden ? 'off' : 'on');
    syncPins();
  });
</script>
