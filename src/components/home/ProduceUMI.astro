---
/** ProduceUMI on the home page: the workshop's logo, what it is, and its newest songs (with snippets and Spotify links). */
import { Picture } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import SnippetButton from '../produce/SnippetButton.astro';
import EditPin from '../ui/EditPin.astro';
import produceLogo from '../../assets/brand/produceumi-logo.png';
import { cmsEntry, cmsNew, cmsPage } from '../../lib/cms';
import { cropStyle, schoolYearLabel, songSnippet, type SongEntry } from '../../lib/content';
import { fitStyle } from '../../lib/fit';

interface Props {
  title: string;
  text: string;
  songs: SongEntry[];
  signupHref: string;
}

const { title, text, songs, signupHref } = Astro.props;
const external = signupHref.startsWith('http');
---

<section class="produce theme-navy section" aria-labelledby="produce-title">
  <div class="produce__glow" aria-hidden="true"></div>
  <div class="container produce__inner">
    <div class="produce__logo" data-reveal>
      <Picture src={produceLogo} alt="ProduceUMI" widths={[360, 540, 720, 960]} sizes="(min-width: 960px) 36vw, 80vw" formats={['avif', 'webp']} />
    </div>

    <div class="produce__copy">
      <p class="eyebrow" data-reveal="fade"><span class="eyebrow__index">A3</span><span>A UMI workshop</span></p>
      <h2 class="produce__title display" id="produce-title" data-reveal="stutter" style={fitStyle(title)}>{title}</h2>
      <p class="produce__text" data-reveal style="--i:1">{text}</p>
      <div class="edit-pins">
        <EditPin inline href={cmsPage('home')} label="Edit section" />
        <EditPin inline add href={cmsNew('songs')} label="Add song" />
      </div>

      {
        songs.length > 0 && (
          <ol class="produce__songs" role="list" aria-label="Latest ProduceUMI songs">
            {songs.map((song, i) => {
              const snippet = songSnippet(song);
              return (
                <li class="produce__song" data-snippet-root data-reveal style={`--i:${i + 2}`}>
                  <span class="produce__cover" aria-hidden="true">
                    {song.data.cover ? (
                      <Picture src={song.data.cover} alt="" widths={[96, 160]} sizes="4.5rem" formats={['avif', 'webp']} style={cropStyle(song.data.coverFocus)} />
                    ) : (
                      <Icon name="waveform" size="1.6rem" />
                    )}
                  </span>
                  <span class="produce__song-text">
                    <a class="produce__song-link" href={`/produceumi/${song.id}/`}>
                      <span class="produce__song-title">{song.data.title}</span>
                    </a>
                    <span class="produce__song-artist">
                      {song.data.artist}
                      <span class="produce__song-year">{schoolYearLabel(song.data.schoolYear)}</span>
                      {song.data.sample && <span class="sample-tag">Sample</span>}
                      <EditPin inline href={cmsEntry(song)} label="Edit song" />
                    </span>
                  </span>
                  <span class="produce__song-actions">
                    {song.data.spotifyUrl && (
                      <a class="produce__spotify" href={song.data.spotifyUrl} target="_blank" rel="noopener noreferrer" title="Listen on Spotify">
                        <Icon name="spotify" size="1.25rem" label={`${song.data.title} on Spotify (opens in a new tab)`} />
                      </a>
                    )}
                    {snippet ? (
                      <SnippetButton src={snippet} title={song.data.title} artist={song.data.artist} />
                    ) : (
                      <span class="produce__song-arrow" aria-hidden="true">
                        <Icon name="arrow-right" size="1rem" />
                      </span>
                    )}
                  </span>
                </li>
              );
            })}
          </ol>
        )
      }

      <div class="btn-row" data-reveal style="--i:5">
        <a class="btn" href="/produceumi/">
          <Icon name="headphones" />
          <span class="btn__label">Hear the songs</span>
        </a>
        <a class="btn btn--ghost" href={signupHref} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
          <span class="btn__label">Make a song with us</span>
          <Icon name={external ? 'arrow-up-right' : 'arrow-right'} />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .produce {
    position: relative;
    overflow: hidden;
  }

  .produce__glow {
    position: absolute;
    top: 50%;
    left: 22%;
    width: min(70vw, 56rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(44 82 224 / 0.5), transparent);
    translate: -50% -50%;
    pointer-events: none;
  }

  .produce__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2xl);
    align-items: center;
  }

  .produce__logo {
    justify-self: center;
    width: min(80%, 30rem);
  }

  .produce__logo :global(img) {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 0 26px rgb(147 163 230 / 0.35));
  }

  .produce__copy {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
    container-type: inline-size;
  }

  .produce__title {
    font-size: min(var(--display-xl), 100cqi / var(--fit, 0.01));
    font-weight: 900;
    line-height: 0.9;
  }

  .produce__text {
    max-width: 46ch;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--fg-muted);
  }

  .produce__songs {
    width: 100%;
    margin-block: var(--space-2xs);
    border-top: 1px solid var(--line-strong);
  }

  .produce__song {
    position: relative;
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--line);
  }

  .produce__song-link {
    color: inherit;
    text-decoration: none;
  }

  /* The whole row opens the song; the Spotify and play buttons sit above this. */
  .produce__song-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .produce__song-link:focus-visible {
    outline: none;
  }

  .produce__song:has(.produce__song-link:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .produce__song-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .produce__spotify {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    color: var(--fg);
    box-shadow: inset 0 0 0 1px var(--line-strong);
    transition:
      color var(--dur-fast),
      box-shadow var(--dur-fast);
  }

  .produce__spotify:hover {
    color: #1ed760;
    box-shadow: inset 0 0 0 1px #1ed760;
  }

  .produce__song.is-playing .produce__song-title,
  .produce__song.is-paused .produce__song-title {
    color: var(--peri);
  }

  .produce__cover {
    display: grid;
    place-items: center;
    width: 3.5rem;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--night-900);
    color: var(--peri);
    box-shadow: 3px 3px 0 var(--orange);
  }

  .produce__cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .produce__song-text {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }

  .produce__song-title {
    font-family: var(--font-display);
    font-stretch: 125%;
    font-size: clamp(0.95rem, 0.85rem + 0.4vw, 1.2rem);
    font-weight: 800;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .produce__song-artist {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
    font-size: var(--step--1);
    color: var(--fg-muted);
  }

  .produce__song-year {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--peri);
  }

  .produce__song-arrow {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    transition: background-color var(--dur-fast), color var(--dur-fast), border-color var(--dur-fast);
  }

  @media (hover: hover) {
    .produce__song:has(.produce__song-link:hover) .produce__song-title {
      color: var(--peri);
    }

    .produce__song:has(.produce__song-link:hover) .produce__song-arrow {
      background: var(--orange);
      border-color: var(--orange);
      color: var(--night-950);
    }
  }

  @media (min-width: 960px) {
    .produce__inner {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: var(--space-3xl);
    }
  }
</style>
