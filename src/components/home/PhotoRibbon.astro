---
/**
 * An endless ribbon of prints from UMI nights (chosen in the CMS, or gallery photos and
 * cover art) drifting slowly across the page. It's purely visual (the same pictures live in the
 * gallery), so screen readers skip it. Hover or the pause button stops it; it stays
 * still for anyone who prefers reduced motion.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import { cropStyle } from '../../lib/content';

interface Props {
  images: { src: ImageMetadata; focus?: string }[];
}

const { images } = Astro.props;
const tilts = [-2.4, 1.6, -1.1, 2.2, -1.8, 0.9, -0.6, 2.8];
const lifts = [0, 16, -10, 12, -14, 6, -4, 14];
const shapes = ['4 / 3', '4 / 5', '1 / 1', '4 / 3', '3 / 4', '1 / 1'];
// About one print every five seconds, so the pace stays calm however many there are.
const seconds = Math.max(40, images.length * 5);
---

<div class="ribbon" data-ribbon>
  <div class="ribbon__viewport" aria-hidden="true">
    <div class="ribbon__track" style={`--ribbon-duration:${seconds}s`}>
      {
        [0, 1].map(() => (
          <div class="ribbon__set">
            {images.map((image, i) => (
              <span
                class="ribbon__print"
                style={`--tilt:${tilts[i % tilts.length]}deg;--lift:${lifts[i % lifts.length]}px;--shape:${shapes[i % shapes.length]}`}
              >
                <Picture src={image.src} alt="" widths={[240, 360, 480]} sizes="(min-width: 768px) 14rem, 10rem" formats={['avif', 'webp']} loading="lazy" decoding="async" style={cropStyle(image.focus)} />
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>
  <button class="ribbon__toggle" type="button" data-ribbon-toggle aria-pressed="false">
    <span class="visually-hidden">Pause the moving photos</span>
    <span class="ribbon__icon ribbon__icon--pause"><Icon name="pause" size="1rem" /></span>
    <span class="ribbon__icon ribbon__icon--play"><Icon name="play" size="1rem" /></span>
  </button>
</div>

<style>
  .ribbon {
    position: relative;
    overflow: hidden;
    /* Extra room at the bottom for the torn paper edge of the next section. */
    padding-block: clamp(1.75rem, 1.2rem + 2vw, 3rem) clamp(2.5rem, 1.8rem + 2.4vw, 4rem);
    background: var(--night-950);
  }

  .ribbon__viewport {
    mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
  }

  .ribbon__track {
    display: flex;
    width: max-content;
    animation: ribbon-scroll var(--ribbon-duration) linear infinite;
    will-change: transform;
  }

  .ribbon__set {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 0.8rem + 1.6vw, 2.25rem);
    padding-inline-end: clamp(1.25rem, 0.8rem + 1.6vw, 2.25rem);
  }

  /* A print: white border, slight tilt and a scattered height, like photos pasted along a wall. */
  .ribbon__print {
    flex: none;
    display: block;
    width: clamp(8.5rem, 6.5rem + 7vw, 13.5rem);
    aspect-ratio: var(--shape);
    border: 6px solid #eef0f4;
    box-shadow: var(--shadow-print);
    transform: translateY(var(--lift)) rotate(var(--tilt));
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .ribbon__print :global(picture),
  .ribbon__print :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (hover: hover) {
    .ribbon:hover .ribbon__track {
      animation-play-state: paused;
    }

    .ribbon__print:hover {
      transform: translateY(calc(var(--lift) - 6px)) rotate(0deg) scale(1.04);
    }
  }

  /* Paused by the button, or (with JavaScript) while scrolled out of view, so it costs nothing during page load. */
  .ribbon[data-paused='true'] .ribbon__track,
  :global(html.js) .ribbon:not(.is-visible) .ribbon__track {
    animation-play-state: paused;
  }

  @keyframes ribbon-scroll {
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .ribbon__toggle {
    position: absolute;
    right: max(0.75rem, calc(var(--gutter) * 0.5));
    bottom: clamp(1.4rem, 1rem + 1.2vw, 2.2rem);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgb(238 241 250 / 0.35);
    border-radius: 50%;
    background: rgb(7 11 31 / 0.75);
    color: var(--chalk);
    transition: background-color var(--dur-fast), color var(--dur-fast);
  }

  .ribbon__toggle:hover {
    background: var(--chalk);
    color: var(--ink);
  }

  .ribbon__icon--play,
  .ribbon__toggle[aria-pressed='true'] .ribbon__icon--pause {
    display: none;
  }

  .ribbon__toggle[aria-pressed='true'] .ribbon__icon--play {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .ribbon__track {
      animation: none;
    }

    .ribbon__toggle {
      display: none;
    }
  }
</style>

<script>
  const watcher =
    'IntersectionObserver' in window
      ? new IntersectionObserver((entries) => entries.forEach((entry) => entry.target.classList.toggle('is-visible', entry.isIntersecting)))
      : null;

  document.querySelectorAll<HTMLElement>('[data-ribbon]').forEach((ribbon) => {
    if (watcher) watcher.observe(ribbon);
    else ribbon.classList.add('is-visible');
    const button = ribbon.querySelector<HTMLButtonElement>('[data-ribbon-toggle]');
    button?.addEventListener('click', () => {
      const paused = button.getAttribute('aria-pressed') !== 'true';
      button.setAttribute('aria-pressed', String(paused));
      ribbon.dataset.paused = String(paused);
    });
  });
</script>
