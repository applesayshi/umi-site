---
/**
 * Play/pause for a ProduceUMI song snippet (behaviour in src/scripts/snippets.ts).
 * - cover: covers a song's artwork or record, with an orange badge in the corner. Clicking the record plays.
 * - round: a small circular button, for song lists.
 * Put data-snippet-root on the card or record around it to style the playing state (spin the disc, etc.).
 */
import Icon from '../ui/Icon.astro';

interface Props {
  src: string;
  title: string;
  artist: string;
  variant?: 'cover' | 'round';
  /** Visible word beside the play icon (cover variant), e.g. "Snippet". */
  text?: string;
  class?: string;
}

const { src, title, artist, variant = 'round', text, class: className } = Astro.props;
---

<button
  class:list={['snippet', `snippet--${variant}`, className]}
  type="button"
  aria-pressed="false"
  data-snippet={src}
  data-snippet-title={title}
  data-snippet-artist={artist}
  title="Play a snippet"
>
  <span class="snippet__chip" aria-hidden="true">
    <span class="snippet__badge">
      <svg class="snippet__ring" viewBox="0 0 40 40">
        <circle class="snippet__track" cx="20" cy="20" r="18.5" pathLength="100"></circle>
        <circle class="snippet__progress" cx="20" cy="20" r="18.5" pathLength="100"></circle>
      </svg>
      <Icon name="play-fill" class="snippet__icon snippet__icon--play" size="1em" />
      <Icon name="pause-fill" class="snippet__icon snippet__icon--pause" size="1em" />
    </span>
    {text && <span class="snippet__text">{text}</span>}
  </span>
  <span class="visually-hidden">Play a snippet of {title} by {artist}</span>
</button>

<style>
  .snippet {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .snippet__chip {
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-pill);
    transition:
      transform var(--dur-base) var(--ease-spring),
      background-color var(--dur-fast),
      color var(--dur-fast),
      box-shadow var(--dur-fast);
  }

  .snippet__badge {
    position: relative;
    display: grid;
    flex: none;
    place-items: center;
    border-radius: 50%;
  }

  .snippet__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    transform: rotate(-90deg);
    pointer-events: none;
  }

  .snippet__ring circle {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-dasharray: 100;
    opacity: 0;
  }

  .snippet__progress {
    stroke-linecap: round;
    stroke-dashoffset: calc(100 - var(--progress, 0) * 100);
    transform-box: fill-box;
    transform-origin: center;
  }

  .snippet :global(.snippet__icon--pause) {
    display: none;
  }

  .snippet.is-playing :global(.snippet__icon--play) {
    display: none;
  }

  .snippet.is-playing :global(.snippet__icon--pause) {
    display: block;
  }

  .snippet.is-playing .snippet__track,
  .snippet.is-paused .snippet__track {
    opacity: 0.22;
  }

  .snippet.is-playing .snippet__progress,
  .snippet.is-paused .snippet__progress {
    opacity: 1;
  }

  /* Waiting for the file: a short arc goes round. */
  .snippet.is-loading .snippet__progress {
    stroke-dashoffset: 72;
    animation: snippet-spin 0.8s linear infinite;
  }

  .snippet.has-error .snippet__chip {
    animation: snippet-nudge 0.4s var(--ease-out);
  }

  @keyframes snippet-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes snippet-nudge {
    25% {
      transform: translateX(-3px);
    }
    75% {
      transform: translateX(3px);
    }
  }

  /* ---- Over artwork: the whole record is the button. --snippet-reach stretches it over a disc poking out the side. ---- */
  .snippet--cover {
    position: absolute;
    inset: 0 var(--snippet-reach, 0) 0 0;
    z-index: 3;
    display: block;
  }

  .snippet--cover .snippet__chip {
    position: absolute;
    left: var(--snippet-inset, 0.7rem);
    bottom: var(--snippet-inset, 0.7rem);
    background: var(--orange);
    color: var(--night-950);
    box-shadow: 0 6px 18px rgb(3 5 18 / 0.5);
  }

  .snippet--cover .snippet__badge {
    width: var(--snippet-size, 3rem);
    height: var(--snippet-size, 3rem);
    font-size: calc(var(--snippet-size, 3rem) * 0.38);
  }

  .snippet__text {
    padding-inline: 0.15rem 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .snippet--cover:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 4px;
  }

  @media (hover: hover) {
    .snippet--cover:hover .snippet__chip {
      transform: scale(1.08);
    }
  }

  /* ---- Round button in lists ---- */
  .snippet--round {
    position: relative;
    z-index: 2;
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
  }

  .snippet--round .snippet__chip,
  .snippet--round .snippet__badge {
    width: 100%;
    height: 100%;
  }

  .snippet--round .snippet__chip {
    justify-content: center;
    box-shadow: inset 0 0 0 1px var(--line-strong);
    font-size: 1rem;
  }

  .snippet--round.is-playing .snippet__chip,
  .snippet--round.is-paused .snippet__chip {
    background: var(--orange);
    color: var(--night-950);
    box-shadow: none;
  }

  @media (hover: hover) {
    .snippet--round:hover .snippet__chip {
      background: var(--orange);
      color: var(--night-950);
      box-shadow: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .snippet__chip {
      transition: none;
    }

    .snippet.has-error .snippet__chip {
      animation: none;
    }

    .snippet.is-loading .snippet__progress {
      animation-duration: 2.4s;
    }
  }
</style>

<script>
  import '../../scripts/snippets';
</script>
