---
/** Every exec, in one dropdown per department. Leads (presidents and VPs) are listed first. */
import { Picture } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import { cropStyle, type TeamEntry } from '../../lib/content';
import { DEPARTMENTS } from '../../lib/constants';
import { fitStyle } from '../../lib/fit';

interface Props {
  members: TeamEntry[];
}

const { members } = Astro.props;
const groups = DEPARTMENTS.map((department) => ({
  department,
  people: members
    .filter((m) => m.data.department === department)
    .sort((a, b) => Number(b.data.lead) - Number(a.data.lead) || a.data.order - b.data.order || a.data.name.localeCompare(b.data.name)),
})).filter((group) => group.people.length > 0);

const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((part) => part[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();
---

<div class="depts">
  {
    groups.map(({ department, people }, i) => (
      <details class="dept" data-reveal style={`--i:${i % 5}`}>
        <summary class="dept__summary">
          <span class="dept__label">
            <span class="dept__name display" style={fitStyle(department)}>
              {department}
            </span>
            <span class="dept__count">
              {people.length} {people.length === 1 ? 'exec' : 'execs'}
            </span>
          </span>
          <span class="dept__icon" aria-hidden="true">
            <Icon name="caret-down" size="1.1rem" />
          </span>
        </summary>
        <ul class="dept__list" role="list">
          {people.map((person) => (
            <li class="person">
              <span class="person__avatar" aria-hidden="true">
                {person.data.photo ? (
                  <Picture src={person.data.photo} alt="" widths={[96, 160]} sizes="3.5rem" formats={['avif', 'webp']} style={cropStyle(person.data.photoFocus)} />
                ) : (
                  <span>{initials(person.data.name)}</span>
                )}
              </span>
              <span class="person__text">
                <span class="person__role">
                  {person.data.role}
                  {person.data.lead && <span class="person__lead">Lead</span>}
                </span>
                <span class="person__name">
                  {person.data.name}
                  {person.data.pronouns && <span class="person__pronouns">({person.data.pronouns})</span>}
                  {person.data.sample && <span class="sample-tag">Sample</span>}
                </span>
                {person.data.program && <span class="person__program">{person.data.program}</span>}
                {person.data.bio && <span class="person__bio">{person.data.bio}</span>}
                {person.data.email && (
                  <a class="link person__email" href={`mailto:${person.data.email}`}>
                    {person.data.email}
                  </a>
                )}
              </span>
            </li>
          ))}
        </ul>
      </details>
    ))
  }
</div>

<style>
  .depts {
    border-top: 1px solid var(--line-strong);
  }

  .dept {
    border-bottom: 1px solid var(--line-strong);
  }

  .dept__summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    min-height: 4.25rem;
    padding-block: 0.9rem;
    cursor: pointer;
    list-style: none;
    transition: color var(--dur-fast);
  }

  .dept__summary::-webkit-details-marker {
    display: none;
  }

  .dept__summary:hover .dept__name,
  .dept[open] .dept__name {
    color: var(--peri);
  }

  /* Name and count share a line when there's room; the count drops below on narrow phones. */
  .dept__label {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.3rem 1rem;
    container-type: inline-size;
  }

  .dept__name {
    font-size: min(var(--display-s), 100cqi / var(--fit, 0.01));
    font-weight: 900;
    line-height: 1;
    transition: color var(--dur-fast);
  }

  .dept__count {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .dept__icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    transition:
      transform var(--dur-base) var(--ease-out),
      background-color var(--dur-fast),
      color var(--dur-fast),
      border-color var(--dur-fast);
  }

  .dept__summary:hover .dept__icon {
    border-color: var(--fg);
  }

  .dept[open] .dept__icon {
    background: var(--peri);
    border-color: var(--peri);
    color: var(--ink);
    transform: rotate(180deg);
  }

  .dept__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-l) var(--space-xl);
    padding-block: 0.5rem var(--space-xl);
  }

  .person {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    align-items: start;
    gap: 1rem;
  }

  .person__avatar {
    display: grid;
    place-items: center;
    width: 3.5rem;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 50%;
    background: var(--night-800);
    box-shadow: 0 0 0 1px var(--line-strong);
    font-family: var(--font-display);
    font-stretch: 125%;
    font-size: 0.95rem;
    font-weight: 900;
    color: var(--peri);
  }

  .person__avatar :global(picture),
  .person__avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .person__text {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }

  .person__role {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--peri);
  }

  .person__lead {
    padding: 0.1em 0.45em;
    border-radius: var(--radius-s);
    background: var(--orange);
    color: var(--night-950);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
  }

  .person__name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.5rem;
    font-family: var(--font-serif);
    font-size: var(--step-2);
    line-height: 1.1;
  }

  .person__pronouns {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--fg-muted);
  }

  .person__program {
    font-size: var(--step--1);
    color: var(--fg-muted);
  }

  .person__bio {
    font-size: var(--step--1);
    line-height: 1.55;
    color: var(--fg-muted);
  }

  .person__email {
    justify-self: start;
    margin-top: 0.15rem;
    font-size: var(--step--1);
    overflow-wrap: anywhere;
  }

  @media (prefers-reduced-motion: reduce) {
    .dept__icon {
      transition: none;
    }
  }
</style>
