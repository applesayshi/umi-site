---
import { EVENT_TYPE_LABELS, eventEnd, type EventEntry } from '../../lib/content';
import { dateParts, dayPadded, monthShort, timeRange, weekdayShort } from '../../lib/dates';
import { seeded, between } from '../../lib/random';
import { fitStyle } from '../../lib/fit';
import Icon from '../ui/Icon.astro';

interface Props {
  event: EventEntry;
  headingLevel?: 'h2' | 'h3';
  index?: number;
}

const { event, headingLevel: Heading = 'h3', index = 0 } = Astro.props;
const { data } = event;
const rand = seeded(event.id);
const tilt = between(rand, -1.4, 1.4).toFixed(2);
const parts = dateParts(data.start);
const serial = `${String(parts.month).padStart(2, '0')}${String(parts.day).padStart(2, '0')}`;
const bars = Array.from({ length: 26 }, () => Math.round(between(rand, 1, 4)));
const barGradient = bars
  .reduce<{ stops: string[]; x: number }>(
    (acc, w, i) => {
      const color = i % 2 === 0 ? 'currentColor' : 'transparent';
      acc.stops.push(`${color} ${acc.x}px ${acc.x + w}px`);
      acc.x += w;
      return acc;
    },
    { stops: [], x: 0 },
  )
  .stops.join(', ');
---

<div class="ticket-wrap" data-reveal style={`--i:${index}`} data-event-end={eventEnd(event).toISOString()}>
<article class="ticket" style={`--tilt:${tilt}deg`}>
  <div class="ticket__main">
    <p class="ticket__meta">
      <span>Admit one</span>
      <span aria-hidden="true">·</span>
      <span>{EVENT_TYPE_LABELS[data.type]}</span>
      {data.sample && <span class="sample-tag">Sample</span>}
    </p>
    <Heading class="ticket__title display" style={fitStyle(data.title)}>
      <a class="ticket__link" href={`/events/${event.id}`}>{data.title}</a>
    </Heading>
    <p class="ticket__venue">
      <Icon name="map-pin" size="1em" />
      <span>{data.venue}</span>
    </p>
    <dl class="ticket__details">
      {
        !data.hideTime && (
          <div>
            <dt>Doors</dt>
            <dd>{timeRange(data.start, data.end)}</dd>
          </div>
        )
      }
      {
        data.priceMember && (
          <div>
            <dt>Members</dt>
            <dd>{data.priceMember}</dd>
          </div>
        )
      }
      {
        data.priceGeneral && (
          <div>
            <dt>General</dt>
            <dd>{data.priceGeneral}</dd>
          </div>
        )
      }
    </dl>
  </div>

  <div class="ticket__stub" aria-hidden="true">
    <span class="ticket__weekday">{weekdayShort(data.start)}</span>
    <span class="ticket__day display">{dayPadded(data.start)}</span>
    <span class="ticket__month">{monthShort(data.start)}</span>
    <span class="ticket__barcode" style={`--bars: linear-gradient(90deg, ${barGradient})`}></span>
    <span class="ticket__serial">Nº {serial}</span>
  </div>
  <time class="visually-hidden" datetime={data.start.toISOString()}>
    {weekdayShort(data.start)} {monthShort(data.start)} {dayPadded(data.start)}
  </time>
</article>
</div>

<style>
  .ticket {
    --stub-w: clamp(5.5rem, 4.5rem + 3vw, 7.5rem);
    --paper: var(--paper-50);
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--stub-w);
    color: var(--ink);
    transform: rotate(var(--tilt));
    transition:
      transform var(--dur-slow) var(--ease-spring),
      filter var(--dur-slow) var(--ease-out);
    filter: drop-shadow(0 18px 24px rgb(0 0 0 / 0.45));
  }

  /* Paper with notches cut where the stub perforates. */
  .ticket::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--paper);
    mask:
      radial-gradient(circle at calc(100% - var(--stub-w)) 0, transparent 0.7rem, #000 calc(0.7rem + 0.5px)) top / 100% 51% no-repeat,
      radial-gradient(circle at calc(100% - var(--stub-w)) 100%, transparent 0.7rem, #000 calc(0.7rem + 0.5px)) bottom / 100% 51% no-repeat;
  }

  .ticket__main {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: 1.25rem 1.25rem 1.35rem 1.4rem;
    min-width: 0;
    container-type: inline-size;
  }

  .ticket__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .ticket__meta :global(.sample-tag) {
    --hot: var(--orange-ink);
  }

  .ticket__title {
    font-size: min(clamp(1.15rem, 0.95rem + 0.8vw, 1.55rem), 100cqi / var(--fit, 0.01));
    font-weight: 900;
    line-height: 0.9;
  }

  .ticket__link {
    color: inherit;
    text-decoration: none;
  }

  .ticket__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .ticket__link:focus-visible {
    outline: none;
  }

  .ticket:has(.ticket__link:focus-visible) {
    outline: 2px solid var(--peri);
    outline-offset: 4px;
  }

  .ticket__venue {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .ticket__details {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin-top: 0.35rem;
    padding-top: 0.75rem;
    border-top: 1px dashed rgb(10 15 38 / 0.3);
  }

  .ticket__details dt {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .ticket__details dd {
    margin: 0;
    font-weight: 600;
    font-size: var(--step--1);
  }

  .ticket__stub {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 0.15rem;
    padding: 1rem 0.5rem;
    border-left: 2px dashed rgb(10 15 38 / 0.35);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transform-origin: left center;
    transition: transform var(--dur-slow) var(--ease-spring);
  }

  .ticket__day {
    font-size: clamp(2rem, 1.7rem + 1.2vw, 2.8rem);
    font-weight: 900;
    line-height: 0.85;
    letter-spacing: 0;
    color: var(--orange-ink);
  }

  .ticket__barcode {
    width: 80%;
    height: 1.6rem;
    margin-top: 0.4rem;
    background: var(--bars);
    color: var(--ink);
    opacity: 0.85;
  }

  .ticket__serial {
    font-size: 0.6rem;
    color: var(--ink-soft);
  }

  @media (hover: hover) {
    .ticket:hover {
      transform: rotate(0deg) translateY(-6px);
      filter: drop-shadow(0 28px 30px rgb(0 0 0 / 0.55));
    }

    .ticket:hover .ticket__stub {
      transform: rotate(3deg) translateX(3px);
    }
  }
</style>
