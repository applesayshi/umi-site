---
/**
 * A pencil that opens a piece of content in the CMS. Visitors never see it: pencils only show for people who
 * have logged in to /admin in this browser, and editors can hide them from the editing bar (layout/EditorBar.astro).
 *
 * By default it floats in the top-right corner of its nearest positioned parent; `inline` keeps it in the flow
 * (inside a row of text, for example). Nudge a floating pencil with --pin-top / --pin-right.
 */
import Icon from './Icon.astro';

interface Props {
  href: string;
  /** What it edits, e.g. "Edit event". Shown when the pencil is hovered or focused. */
  label: string;
  /** A plus instead of a pencil, for adding something new. */
  add?: boolean;
  inline?: boolean;
  class?: string;
  style?: string;
}

const { href, label, add = false, inline = false, class: className, style } = Astro.props;
---

<a class:list={['edit-pin', inline && 'edit-pin--inline', add && 'edit-pin--add', className]} href={href} style={style} data-edit-pin>
  <Icon name={add ? 'plus' : 'pencil'} size="0.95rem" />
  <span class="edit-pin__label">{label}</span>
</a>
