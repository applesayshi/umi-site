---
/**
 * Hand-drawn marker marks for the zine layer: circles around words, arrows,
 * underlines, stars, thorny vines, eyes. They draw themselves in when revealed.
 * Always decorative (aria-hidden).
 */
interface Props {
  variant: 'circle' | 'underline' | 'arrow' | 'star' | 'scribble' | 'vine' | 'eye' | 'burst' | 'cross' | 'loop';
  color?: string;
  width?: number;
  class?: string;
  /** Stroke draws in when the element scrolls into view. */
  draw?: boolean;
  style?: string;
}

const { variant, color = 'var(--orange)', width = 3, class: className, draw = true, style = '' } = Astro.props;

const paths: Record<Props['variant'], { viewBox: string; d: string[]; fill?: boolean }> = {
  circle: {
    viewBox: '0 0 300 140',
    d: ['M34 82 C 22 38, 118 12, 176 14 C 246 16, 290 44, 282 80 C 274 118, 190 132, 124 128 C 58 124, 14 104, 26 66 C 34 44, 78 26, 130 20'],
  },
  underline: {
    viewBox: '0 0 300 40',
    d: ['M6 26 C 60 16, 130 12, 196 18 C 236 22, 268 20, 294 12', 'M40 34 C 104 26, 170 26, 262 28'],
  },
  arrow: {
    viewBox: '0 0 160 120',
    d: ['M10 20 C 40 30, 70 58, 96 96', 'M70 90 L 98 100 L 104 70'],
  },
  star: {
    viewBox: '0 0 120 120',
    d: ['M60 8 L 70 46 L 112 50 L 78 72 L 90 112 L 60 88 L 28 112 L 40 72 L 8 50 L 50 46 Z'],
  },
  scribble: {
    viewBox: '0 0 240 160',
    d: ['M20 120 C 40 20, 80 150, 100 60 C 116 -4, 150 150, 170 70 C 186 12, 210 120, 226 40', 'M30 90 C 70 70, 130 110, 210 76'],
  },
  vine: {
    viewBox: '0 0 140 420',
    d: [
      'M70 414 C 60 330, 96 280, 74 210 C 56 150, 92 90, 72 8',
      'M76 330 C 104 318, 118 300, 132 290 M 90 318 L 100 300',
      'M68 262 C 40 250, 22 236, 8 222 M 50 252 L 44 236',
      'M78 186 C 106 170, 118 150, 130 132 M 100 168 L 112 156',
      'M72 118 C 48 104, 34 90, 20 70 M 44 100 L 34 90',
      'M72 58 C 92 46, 104 34, 112 18',
    ],
  },
  eye: {
    viewBox: '0 0 200 110',
    d: ['M8 56 C 50 6, 150 6, 192 56 C 150 104, 50 104, 8 56 Z', 'M100 30 C 116 30, 126 42, 126 56 C 126 72, 114 82, 100 82 C 84 82, 74 70, 74 56 C 74 42, 86 30, 100 30 Z', 'M94 50 L 106 62 M 106 50 L 94 62'],
  },
  burst: {
    viewBox: '0 0 160 160',
    d: ['M80 6 L80 44 M80 116 L80 154 M6 80 L44 80 M116 80 L154 80 M28 28 L54 54 M106 106 L132 132 M132 28 L106 54 M54 106 L28 132'],
  },
  cross: {
    viewBox: '0 0 120 120',
    d: ['M14 16 C 44 44, 76 74, 106 104', 'M104 14 C 76 46, 44 76, 16 106'],
  },
  loop: {
    viewBox: '0 0 300 120',
    d: ['M8 70 C 40 70, 60 20, 90 24 C 124 28, 96 96, 70 88 C 44 80, 110 30, 160 44 C 210 58, 196 104, 170 98 C 144 92, 214 28, 292 50'],
  },
};

const shape = paths[variant];
---

<svg
  class:list={['scribble', `scribble--${variant}`, draw && 'scribble--draw', className]}
  viewBox={shape.viewBox}
  aria-hidden="true"
  focusable="false"
  style={`--scribble-color:${color};${style}`}
  data-reveal={draw ? 'fade' : undefined}
>
  {shape.d.map((d) => <path d={d} pathLength="1" stroke-width={width} vector-effect="non-scaling-stroke" />)}
</svg>

<style>
  .scribble {
    display: block;
    overflow: visible;
    fill: none;
    stroke: var(--scribble-color);
    stroke-linecap: round;
    stroke-linejoin: round;
    pointer-events: none;
  }

  /* Draw-in: the reveal system adds .is-in when the mark scrolls into view. */
  :global(html.js) .scribble--draw path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.1s var(--ease-out);
  }

  :global(html.js) .scribble--draw:global(.is-in) path {
    stroke-dashoffset: 0;
  }

  :global(html.js) .scribble--draw path:nth-child(2) {
    transition-delay: 0.35s;
  }

  :global(html.js) .scribble--draw path:nth-child(n + 3) {
    transition-delay: 0.6s;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .scribble--draw path {
      stroke-dashoffset: 0;
      transition: none;
    }
  }
</style>
